4bcfbf7bb2c4"],

Cell[TextData[Cell[BoxData[
 RowBox[{"a", " ", "=", " ", 
  RowBox[{
   FractionBox["\[Omega]", "\[Pi]"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", 
     FractionBox[
      RowBox[{"2", "\[Pi]"}], "\[Omega]"]], 
    RowBox[{"x", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Omega]", " ", "t"}], "]"}], 
     RowBox[{"\[DifferentialD]", "t"}]}]}]}]}]],
 CellChangeTimes->{{3.907760028712701*^9, 3.907760099774433*^9}, {
   3.9077602769967327`*^9, 3.9077602824529877`*^9}, 
