Cell[BoxData["\<\"[acos((rho.^2.*omega.^2+2.*rho.*omega.*sin(phi).*(omega_h)+(\
 ...\\nomega_h).^2).^(-1).*(rho.*omega.*sin(phi).*(omega_h)+(omega_h).^2+ ...\
\\n(-1).*(rho.^3.*omega.^3.*cos(phi).^2.*(rho.*omega+2.*sin(phi).*( \
...\\nomega_h))).^(1/2)))];\"\>"], "Print",
