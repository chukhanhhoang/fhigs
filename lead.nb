  3.9937984958302097`*^9}},ExpressionUUID->"d12d3d8e-8a0e-4c5a-808f-\
5f48fa829ef6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"x1", "*", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Omega]", " ", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         FractionBox["\[Gamma]", "\[Omega]"]}], "}"}]}], "]"}], " ", "\n", 
     "+", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"x2", "*", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Omega]", " ", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         FractionBox["\[Gamma]", "\[Omega]"], ",", 
         FractionBox[
          RowBox[{"\[Pi]", "-", "\[Phi]"}], "\[Omega]"]}], "}"}]}], "]"}], 
     " ", "\n", "+", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"x3", " ", "*", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Omega]", " ", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         FractionBox[
          RowBox[{"\[Pi]", "-", "\[Phi]"}], "\[Omega]"], ",", 
         FractionBox["\[Pi]", "\[Omega]"]}], "}"}]}], "]"}], " ", "\n", "+", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"x4", "*", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Omega]", " ", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         FractionBox["\[Pi]", "\[Omega]"], ",", 
         FractionBox[
          RowBox[{"\[Pi]", "+", "\[Gamma]"}], "\[Omega]"]}], "}"}]}], "]"}], 
     " ", "\n", "+", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"x2", "*", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Omega]", " ", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         FractionBox[
          RowBox[{"\[Pi]", "+", "\[Gamma]"}], "\[Omega]"], ",", 
         FractionBox[
          RowBox[{
           RowBox[{"2", "\[Pi]"}], "-", "\[Phi]"}], "\[Omega]"]}], "}"}]}], 
      "]"}], "\n", "+", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"x3", "*", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Omega]", " ", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         FractionBox[
          RowBox[{
