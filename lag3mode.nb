Cell[BoxData["\<\"[pi \
+acos((rho.*omega.*sin(phi)+(omega_h)).*(rho.^2.*omega.^2+2.* \
...\\nrho.*omega.*sin(phi).*(omega_h)+(omega_h).^2).^(-1/2))];\"\>"], "Print",
 CellChangeTimes->{3.9948239268689337`*^9},
 CellLabel->
  "During evaluation of \
In[75]:=",ExpressionUUID->"bef21289-d27f-478d-a72e-4b9bdfa59cd1"],

Cell["\<\
\\left\\{\\left(\\delta \\to \\cos ^{-1}\\left(\\frac{\\omega _h+\\rho  \
\\omega  \\sin (\\phi )}{\\sqrt{2
   \\rho  \\omega  \\omega _h \\sin (\\phi )+\\omega _h^2+\\rho ^2 \\omega \
^2}}\\right)\\right)+\\pi
   \\right\\}\
\>", "Output",
 CellChangeTimes->{3.9948239268729296`*^9},
 CellLabel->
